  "description": "Named arrangements for the Obsidian right sidebar.",
  "author": "Ruben Khachaturov (https://github.com/mrkhachaturov)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrkhachaturov/obsidian-sidebar-layouts.git"
