    "jsdom": "30.0.1",
    "knip": "6.35.0",
    "obsidian": "1.13.1",
    "stylelint": "17.6.0",
    "stylelint-no-unsupported-browser-features": "8.1.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
