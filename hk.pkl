/// The git-lifecycle gate. Installs itself from mise's postinstall
/// (`hk install --mise`). Bypass one command with `HK=0`.
amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"

local hygiene = new Mapping<String, Step> {
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-symlinks"] = Builtins.check_symlinks
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["end-of-file"] = Builtins.newlines
  ["mixed-line-ending"] = Builtins.mixed_line_ending
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["no-commit-to-main"] = Builtins.no_commit_to_branch
      ...hygiene
      ["biome"] = new Step {
        glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.json", "**/*.jsonc", "**/*.css")
        fix = "flint run --fix --allow-fixed biome"
      }
      ["rumdl"] = new Step {
        glob = List("**/*.md")
        fix = "flint run --fix --allow-fixed rumdl"
      }
      ["ryl"] = new Step {
        glob = List("**/*.yml", "**/*.yaml")
        fix = "flint run --fix --allow-fixed ryl"
      }
      ["taplo"] = new Step {
        glob = List("**/*.toml")
        fix = "flint run --fix --allow-fixed taplo"
      }
      ["shellcheck"] = new Step {
        glob = List("**/*.sh")
        check = "flint run shellcheck"
      }
      ["actionlint"] = new Step {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        check = "flint run actionlint"
      }
      // Checked, not fixed: a workflow security rewrite is a decision, not formatting.
      ["zizmor"] = new Step {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        check = "flint run zizmor"
      }
      ["flint-setup"] = new Step {
        glob = List("mise.toml")
        fix = "flint run --fix --allow-fixed flint-setup"
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }

  ["pre-push"] {
    steps {
      ["gates"] = new Step { check = "mise run check" }
    }
  }

  ["check"] {
    steps {
      ...hygiene
      ["gates"] = new Step {
        check = "mise run check"
        exclusive = true
      }
    }
  }

  ["fix"] {
    fix = true
    steps {
      ...hygiene
      ["flint"] = new Step {
        fix = "flint run --fix --allow-fixed"
        exclusive = true
      }
    }
  }
}
